# Copy to .env and adjust:  cp .env.example .env
# Used by docker compose (container environment + port interpolation). Never commit .env.
#
# Every variable also accepts a *_FILE variant (path to a file holding the value, e.g. a
# Docker secret): ADMIN_PASSWORD_FILE=/run/secrets/admin_password. *_FILE wins over the plain one.
# Don't quote values. Empty value = unset.
#
# Runtime settings (marked "seed") are copied into the SQLite DB on FIRST start only; after
# that the value stored in the DB (editable in the UI) always wins over this file.

# --- Published host ports (compose only) -----------------------------------------------------
SMTP_PUBLISH_PORT=25
# Bind web UI to localhost and reach it through a TLS reverse proxy:
WEB_PUBLISH=127.0.0.1:8080

# --- Bootstrap (read at every start, env only) -------------------------------------------------
# Initial admin, created only if there are no users yet. If the password is empty a random one
# is generated and printed once in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Signs session cookies. Empty = generated once and stored in /data/secret_key.
SECRET_KEY=
# true when the UI is served over HTTPS (recommended)
COOKIE_SECURE=false
# Opportunistic STARTTLS on the SMTP port (paths inside the container; mount the certs, see compose)
TLS_CERT_PATH=
TLS_KEY_PATH=
# Rarely needed: the image already listens on 2525 (SMTP) and 8080 (web)
# SMTP_LISTEN_PORT=2525
# WEB_PORT=8080

# --- Receiving (seed) ---------------------------------------------------------------------------
# Comma separated; *.example.com matches subdomains. EMPTY = ACCEPT MAIL FOR ANY DOMAIN.
LOCAL_DOMAINS=example.com
# reject with 550 when SPF fails
SPF_REJECT=false

# --- Abuse limits for the public SMTP port (seed; 0 = unlimited) ---------------------------------
# bytes (default 25 MiB). Raising it needs a restart.
MAX_MESSAGE_SIZE=26214400
# each recipient stores its own copy, so keep this small
MAX_RECIPIENTS=10
# messages per source IP per minute (450 beyond)
RATE_LIMIT_PER_IP=30
# concurrent connections, globally and per source IP (421 beyond)
MAX_CONNECTIONS=50
MAX_CONNECTIONS_PER_IP=5
# commands of one kind per session (MAIL, RCPT, NOOP, ...). Needs a restart.
COMMAND_LIMIT=50

# --- Storage (seed) -----------------------------------------------------------------------------
# delete unflagged mail older than N days, 0 = keep forever
RETENTION_DAYS=30
# deleted mail stays in the recycle bin this many days, then is removed for good. 0 = until emptied by hand
TRASH_DAYS=30
# refuse new mail (452) when stored mail reaches this size, in MB. 0 = unlimited
MAX_STORAGE_MB=5120

# --- Forwarding SMTP account (seed) -------------------------------------------------------------
FORWARD_SMTP_HOST=
FORWARD_SMTP_PORT=587
# starttls | ssl | none
FORWARD_SMTP_SECURITY=starttls
FORWARD_SMTP_USER=
FORWARD_SMTP_PASSWORD=
# From address of forwarded mail (defaults to FORWARD_SMTP_USER)
FORWARD_FROM=
# max forwards triggered by rules per hour (the mail is still stored when exceeded)
FORWARD_LIMIT_PER_HOUR=60
